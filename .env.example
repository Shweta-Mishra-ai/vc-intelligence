# ============================================
# VC Intelligence Platform — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your keys
# All search APIs have generous free tiers

# === AI Analysis Engine ===
# OpenAI: https://platform.openai.com/api-keys
# Used for: Company analysis, thesis matching, predictions
OPENAI_API_KEY=sk-your-openai-key-here

# === Search & Discovery APIs (Free Tiers) ===

# Tavily AI Search: https://app.tavily.com (1,000 free credits/month)
# Used for: Deep web search, structured company data
TAVILY_API_KEY=tvly-your-tavily-key-here

# Exa Search: https://dashboard.exa.ai (1,000 free searches/month)
# Used for: Semantic company search, competitor discovery
EXA_API_KEY=your-exa-key-here

# GitHub: https://github.com/settings/tokens (5,000 req/hr free)
# Used for: Developer metrics, repo activity, tech stack analysis
# Optional — works without it at lower rate limit
GITHUB_TOKEN=ghp-your-github-token-here

# === Scraping (Optional) ===
# Firecrawl: https://firecrawl.dev (500 free pages/month)
# Used for: JS-rendered page scraping (fallback to Cheerio if not set)
FIRECRAWL_API_KEY=fc-your-firecrawl-key-here

# === App Configuration ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
