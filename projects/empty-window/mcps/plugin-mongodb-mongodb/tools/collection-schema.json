{
  "name": "collection-schema",
  "description": "Describe the schema for a collection",
  "arguments": {
    "type": "object",
    "properties": {
      "database": {
        "type": "string"
      },
      "collection": {
        "type": "string"
      },
      "sampleSize": {
        "default": 50,
        "type": "number"
      },
      "responseBytesLimit": {
        "default": 1048576,
        "type": "number"
      }
    },
    "required": [
      "database",
      "collection"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "schema": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "fieldsCount": {
        "type": "number"
      }
    },
    "required": [
      "schema",
      "fieldsCount"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  }
}