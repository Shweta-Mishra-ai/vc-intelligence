{
  "name": "update-many",
  "description": "Updates all documents that match the specified filter for a collection. If the list of documents is above com.mongodb/maxRequestPayloadBytes, consider updating them in batches.",
  "arguments": {
    "type": "object",
    "properties": {
      "database": {
        "type": "string"
      },
      "collection": {
        "type": "string"
      },
      "filter": {
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      },
      "update": {
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      },
      "upsert": {
        "type": "boolean"
      }
    },
    "required": [
      "database",
      "collection",
      "update"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "database": {
        "type": "string"
      },
      "collection": {
        "type": "string"
      },
      "matchedCount": {
        "type": "number"
      },
      "modifiedCount": {
        "type": "number"
      },
      "upsertedCount": {
        "type": "number"
      },
      "upsertedId": {
        "type": "string"
      }
    },
    "required": [
      "database",
      "collection",
      "matchedCount",
      "modifiedCount",
      "upsertedCount"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  }
}